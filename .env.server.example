# GENERATED from deploy/env/schema by `scripts/prod-env.sh example`. Do not edit by hand.
# Production key list. Create the real file (asks for APP_URL and IMAGE_REPO, generates every secret):
#   scripts/prod-env.sh init      then: make prod-config && make prod-up
# Existing deployment: scripts/prod-env.sh upgrade   verify: scripts/prod-env.sh check
# Values are examples for https://app.example.com and ghcr.io/example/app; secrets stay blank on purpose.
# Keys not listed keep their compose.prod.yml defaults (all documented in .env.example).
ENV_SCHEMA_VERSION=2

# --- Identity ---
# Public origin of the app (the frontend domain). Every URL below derives from it.
APP_URL=https://app.example.com
# Unique per app on a host: names containers, volumes and the app network.
# Plain Docker host only (Dokploy creates it): docker network create dokploy-network
NAME_PREFIX=app
# Images are prebuilt by CI and pulled, never built on the server. CI publishes
# ghcr.io/<owner>/<repo>-<service> (lowercase) as :main, :sha-<short> and :v0.N;
# pin a deploy by editing the tags. Private packages: add a ghcr.io registry
# (read:packages PAT) in Dokploy. Dokploy deploys on git tags v0.*.
IMAGE_REPO=ghcr.io/example/app
BACKEND_IMAGE=ghcr.io/example/app-backend:main
FRONTEND_IMAGE=ghcr.io/example/app-frontend:main
IMAGE_PULL_POLICY=always

# --- Public URLs ---
AUTH_URL=https://app.example.com
PUBLIC_FRONTEND_URL=https://app.example.com
CORS_ALLOWED_ORIGINS=https://app.example.com
CENTRIFUGO_ALLOWED_ORIGINS=https://app.example.com
# Centrifugo has its own domain (Dokploy: service centrifugo, container port 8000).
CENTRIFUGO_WS_URL=wss://realtime.app.example.com/connection/websocket
NEXT_PUBLIC_CENTRIFUGO_URL=wss://realtime.app.example.com/connection/websocket

# --- Database, cache, object storage ---
DB_USER=app
DB_NAME=app
# Postgres stores this in its volume at first start. To change it, ALTER USER first,
# then edit this file by hand; `--rotate` refuses it.
# secret: generated by init (alnum, 32 chars)
DB_PASSWORD=
# secret: generated by init (alnum, 32 chars)
REDIS_PASSWORD=
S3_BUCKET=app
# secret: generated by init (alnum, 20 chars)
S3_ACCESS_KEY=
# secret: generated by init (alnum, 40 chars)
S3_SECRET_KEY=

# --- Signing and encryption secrets ---
# secret: generated by init (hex, 32 bytes)
JWT_ACCESS_SECRET=
# secret: generated by init (hex, 32 bytes)
JWT_REFRESH_SECRET=
# secret: generated by init (b64, 32 bytes)
AUTH_SECRET=
# secret: generated by init (hex, 32 bytes)
AUTH_ADAPTER_SECRET=
# Encrypts credentials stored in the database. Never rotate it: they become unreadable.
# secret: generated by init (b64, 32 bytes)
APP_ENCRYPTION_KEY=
# secret: generated by init (hex, 32 bytes)
CENTRIFUGO_API_KEY=
# secret: generated by init (hex, 32 bytes)
CENTRIFUGO_TOKEN_HMAC_SECRET=
# secret: generated by init (hex, 32 bytes)
MEILI_MASTER_KEY=

# --- Web Push (VAPID) ---
# VAPID public key: generated by init with its pair
VAPID_PUBLIC_KEY=
# VAPID private key: generated by init with its pair
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:noreply@app.example.com

# --- Mail (fill in your SMTP provider) ---
MAIL_FROM=noreply@app.example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# --- Error tracking (optional; empty = off) ---
BACKEND_SENTRY_DSN=
FRONTEND_SENTRY_DSN=
