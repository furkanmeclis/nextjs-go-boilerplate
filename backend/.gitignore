# Binaries
/bin/
/dist/
*.exe
*.test
*.out
coverage.out
coverage.html

# Env & secrets
.env
.env.local
.env.*.local
*.pem
*.key
# ...except the license core's embedded PUBLIC keys (safe to commit; the
# private halves live only on the author's machine). The *.pub.pem suffix is
# deliberate: only public keys are re-included, so a private *.key.pem dropped
# into this directory stays ignored. See docs/design/license-core.md.
!internal/platform/license/keys/
!internal/platform/license/keys/*.pub.pem

# IDE / OS
.idea/
.vscode/
.DS_Store

# Tool caches
.vendor-new/
tmp/

# Air / live reload
tmp/
bin/

# Local object storage
storage/objects/

# whatsmeow Linked Devices session DBs (per channel_account uuid)
storage/whatsmeow/

# Debug
debug
__debug_bin*
